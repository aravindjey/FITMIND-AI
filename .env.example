# Environment Configuration Example
# Copy this file to .env before starting the application

# Environment mode: development | testing | production
ENVIRONMENT=development

# API Settings
SECRET_KEY=dev-secret-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days

# Database Settings
# For PostgreSQL (Docker / Production):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_fitness_coach
# For Local SQLite testing / dev fallback:
# DATABASE_URL=sqlite+aiosqlite:///./ai_fitness_coach.db

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Provider Configuration (Provider-Independent)
# Options: mock | openai | anthropic | gemini | ollama
LLM_PROVIDER=mock
PRIMARY_MODEL_NAME=gpt-4o-mini
VISION_MODEL_NAME=gpt-4o-mini

# API Keys (Optional in dev - system uses mock/fallback when omitted)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Safety Rules Configuration
SAFETY_MIN_BMR_MULTIPLIER=1.0
SAFETY_ABSOLUTE_MIN_CALORIES=1200
SAFETY_MAX_DAILY_DEFICIT_PERCENT=0.25
DEFAULT_CURRENCY=INR

# Frontend Settings (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
